# OmniFlow AI Configuration

# Application
APP_NAME=OmniFlow AI
APP_ENV=production
DEBUG=false
SECRET_KEY=change-this-in-production-to-a-secure-32-character-random-key
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omniflow_db
POSTGRES_USER=omniflow
POSTGRES_PASSWORD=omniflow_secret
DATABASE_URL=postgresql+asyncpg://omniflow:omniflow_secret@localhost:5432/omniflow_db

# Redis & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector Stores
DEFAULT_VECTOR_STORE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
CHROMA_PERSIST_DIRECTORY=./data/chroma

# LLM Providers
OPENAI_API_KEY=sk-demo-openai-key
ANTHROPIC_API_KEY=sk-ant-demo-key
GOOGLE_API_KEY=demo-gemini-key
DEEPSEEK_API_KEY=demo-deepseek-key
MISTRAL_API_KEY=demo-mistral-key
OLLAMA_BASE_URL=http://localhost:11434

# Security & Guardrails
ENABLE_SAFETY_GUARDRAILS=true
PII_REDACTION_ENABLED=true
MAX_REQUEST_TOKENS_PER_MINUTE=100000

# Telemetry & Tracing
ENABLE_TELEMETRY=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PORT=9090
